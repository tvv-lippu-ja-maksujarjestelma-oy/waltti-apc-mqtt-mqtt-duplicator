{
  "name": "waltti-apc-mqtt-mqtt-duplicator",
  "version": "0.1.0",
  "description": "Duplicate MQTT topics from a source broker to a destination broker (RabbitMQ MQTT)",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check-and-build": "npm run ts:check && npm run prettier:check && npm run eslint && npm run test && npm run build",
    "eslint": "eslint . --max-warnings=0",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "start": "node dist/src/index.js",
    "test": "jest",
    "ts:check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvv-lippu-ja-maksujarjestelma-oy/waltti-apc-mqtt-mqtt-duplicator.git"
  },
  "keywords": [
    "mqtt",
    "rabbitmq",
    "duplicator",
    "bridge"
  ],
  "author": "haphut <haphut@mistmap.com>",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/tvv-lippu-ja-maksujarjestelma-oy/waltti-apc-mqtt-mqtt-duplicator/issues"
  },
  "homepage": "https://github.com/tvv-lippu-ja-maksujarjestelma-oy/waltti-apc-mqtt-mqtt-duplicator#readme",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@tsconfig/strictest": "^2.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "async-mqtt": "^2.6.3",
    "pino": "^8.16.2"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "./dist"
    ]
  }
